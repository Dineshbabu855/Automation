{
  "name": "Automation Trigger",
  "module": "Automation Builder",
  "doctype": "DocType",
  "istable": 1,
  "fields": [
    {
      "fieldname": "trigger_type",
      "fieldtype": "Select",
      "label": "Trigger Type",
      "options": "DocType Event\nManual\nSchedule",
      "default": "DocType Event",
      "reqd": 1,
      "index": 1,
      "description": "DocType Event: fires on document save. Manual: user triggers via Run Now. Schedule: fires on a time interval."
    },
    {
      "fieldname": "trigger_doctype",
      "fieldtype": "Link",
      "label": "Trigger DocType",
      "options": "DocType",
      "reqd": 1,
      "index": 1
    },
    {
      "fieldname": "trigger_event",
      "fieldtype": "Select",
      "label": "Trigger Event",
      "options": "After Insert\nOn Update\nOn Submit\nOn Cancel",
      "reqd": 1,
      "index": 1,
      "depends_on": "eval:doc.trigger_type === 'DocType Event'"
    },
    {
      "fieldname": "schedule_frequency",
      "fieldtype": "Select",
      "label": "Frequency",
      "options": "Hourly\nDaily\nWeekly",
      "depends_on": "eval:doc.trigger_type === 'Schedule'"
    },
    {
      "fieldname": "next_run",
      "fieldtype": "Datetime",
      "label": "Next Run",
      "read_only": 1,
      "depends_on": "eval:doc.trigger_type === 'Schedule'"
    },
    {
      "fieldname": "last_run",
      "fieldtype": "Datetime",
      "label": "Last Run",
      "read_only": 1,
      "depends_on": "eval:doc.trigger_type === 'Schedule'"
    },
    {
      "fieldname": "condition_logic",
      "fieldtype": "Select",
      "label": "Condition Logic",
      "options": "All must match\nAny must match",
      "default": "All must match",
      "description": "How multiple conditions within this trigger row are combined."
    },
    {
      "fieldname": "conditions",
      "fieldtype": "Table",
      "label": "Conditions",
      "options": "Automation Trigger Condition"
    },
    {
      "fieldname": "condition_field",
      "fieldtype": "Data",
      "label": "Condition Field (Legacy)",
      "hidden": 1
    },
    {
      "fieldname": "condition_operator",
      "fieldtype": "Select",
      "label": "Condition Operator (Legacy)",
      "options": "=\n!=\n>\n<\n>=\n<=",
      "hidden": 1
    },
    {
      "fieldname": "condition_value",
      "fieldtype": "Data",
      "label": "Condition Value (Legacy)",
      "hidden": 1
    }
  ],
  "indexes": [
    {"fields": ["trigger_doctype", "trigger_event"], "unique": 0}
  ]
}
